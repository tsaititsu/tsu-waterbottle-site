# Copy manually to /etc/line-pay-gateway/gateway.env on the Sandbox host.
# The real file must be owned by root, mode 600, and must never enter Git or an image.
PORT=3000
LINE_PAY_GATEWAY_ENV=sandbox
LINE_PAY_GATEWAY_KEY_ID=replace-with-a-sandbox-key-id
LINE_PAY_GATEWAY_SECRET=replace-with-a-random-sandbox-shared-secret
LINE_PAY_UPSTREAM_TIMEOUT_MS=5000
GATEWAY_TIMESTAMP_TOLERANCE_SECONDS=60
GATEWAY_REPLAY_TTL_SECONDS=120
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX=120
