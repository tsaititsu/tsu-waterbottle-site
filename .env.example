NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_LINE_PROVIDER=custom:line
SUPABASE_LINE_PROVIDER=custom:line
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_TUNNEL_URL=
ENABLE_DIVINATION_DB_READINGS=false
OPENAI_API_KEY=
OPENAI_AI_CHART_MODEL=gpt-5.6-sol
OPENAI_DIVINATION_MODEL=gpt-5.5

NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_ENV=test
NEWEBPAY_VERSION=2.3
NEXT_PUBLIC_ENABLE_NEWEBPAY=false
NEXT_PUBLIC_ENABLE_AI_CHART_NEWEBPAY=false
NEWEBPAY_ENABLE_TEST_PAYMENT=false
ENABLE_NEWEBPAY_ONE_DOLLAR_TEST_MODE=false
# 紫微占卜管理員限定 NT$1 實刷測試（server-only；需同時開啟上面的一元測試總開關，
# production 另需既有 NEWEBPAY_ONE_DOLLAR_TEST_PRODUCTION_CONFIRMATION，且登入者需在 ADMIN_EMAILS 內）
ENABLE_DIVINATION_ONE_DOLLAR_TEST_MODE=false
NEXT_PUBLIC_ENABLE_NEWEBPAY_ONE_DOLLAR_TEST_NOTICE=false
NEWEBPAY_ONE_DOLLAR_TEST_PRODUCTION_CONFIRMATION=
ENABLE_NEWEBPAY_APPLE_PAY_TEST_MODE=false
NEXT_PUBLIC_ENABLE_NEWEBPAY_APPLE_PAY_TEST_ENTRY=false

NEXT_PUBLIC_ENABLE_LINE_PAY=false
NEXT_PUBLIC_ENABLE_COURSE_SALES=false
LINE_PAY_ENV=sandbox
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=
LINE_PAY_CONFIRM_URL=
LINE_PAY_CANCEL_URL=
LINE_PAY_TRANSPORT=direct
LINE_PAY_GATEWAY_URL=
LINE_PAY_GATEWAY_KEY_ID=
LINE_PAY_GATEWAY_SECRET=
LINE_PAY_GATEWAY_TIMEOUT_MS=5000
# Server-only Sandbox/Production-scoped Secret API Key whose
# secret_jwt_template is exactly role=line_pay_payment_executor. The executor
# client sends it only as apikey to the reviewed atomic finalize RPC; never use
# service_role, expose it through NEXT_PUBLIC_*, or send it as Authorization.
SUPABASE_LINE_PAY_EXECUTOR_API_KEY=
# 僅供分支限定 Vercel Preview 的單一 exact-head Sandbox NT$1 E2E；Production 必須維持 false。
LINE_PAY_SANDBOX_E2E_ENABLED=false
# 僅供管理員執行一次 Production NT$1 真實扣款；平時兩者都必須停用。
LINE_PAY_PRODUCTION_ONE_DOLLAR_TEST_ENABLED=false
LINE_PAY_PRODUCTION_ONE_DOLLAR_TEST_CONFIRMATION=
LINE_PAY_PRODUCTION_ONE_DOLLAR_TEST_EXPIRES_AT=

GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_TIMEZONE=Asia/Taipei

RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFY_EMAIL=

# 後台管理員 email allowlist（server-only，逗號分隔，未設定時後台一律拒絕存取）
# 範例：ADMIN_EMAILS=admin@example.com,owner@example.com
ADMIN_EMAILS=
